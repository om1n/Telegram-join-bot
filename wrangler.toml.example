name = "telegram-join-request-bot"
main = "src/worker.js"
compatibility_date = "2024-01-01"

[triggers]
crons = ["0 * * * *"] # Run once an hour

[[d1_databases]]
binding = "DB"
database_name = "joinbot"
database_id = "YOUR_DATABASE_ID_HERE"

# [vars]
# ALLOWED_CHAT_ID = "-1001234567890" # Optional: restrict join requests to this chat ID
# DEBUG = "false"                     # Optional: set to "true" for verbose debug logging
